{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://info-test-rs.local/schemas/config/ai.schema.json",
  "title": "config/ai.yaml AI要約・タグ付けの設定",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "model",
    "prices",
    "effort",
    "fallbacks",
    "limits"
  ],
  "properties": {
    "provider": {
      "enum": [
        "anthropic"
      ],
      "description": "実装しているのは1つだけ"
    },
    "model": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"
    },
    "effort": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "fallbacks": {
      "type": "boolean"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_articles_per_run",
        "max_input_chars",
        "max_input_tokens_per_run",
        "max_output_tokens",
        "max_retries"
      ],
      "properties": {
        "max_articles_per_run": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "max_input_chars": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 200000
        },
        "max_input_tokens_per_run": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 5000000
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 512,
          "maximum": 32000
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "prices": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "output"
        ],
        "properties": {
          "input": {
            "type": "number",
            "minimum": 0
          },
          "output": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "description": "モデルごとの価格（米ドル／100万トークン）"
    }
  }
}
